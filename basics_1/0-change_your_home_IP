#!/usr/bin/env bash
# Configures /etc/hosts so localhost resolves to 127.0.0.2 and facebook.com to 8.8.8.8
cp /etc/hosts /tmp/hosts_tmp
sed 's/127.0.0.1 localhost/127.0.0.2 localhost/' /tmp/hosts_tmp > /etc/hosts
if grep -q "facebook.com" /etc/hosts; then
    cp /etc/hosts /tmp/hosts_tmp
    sed 's/.*facebook.com.*/8.8.8.8 facebook.com/' /tmp/hosts_tmp > /etc/hosts
else
    echo "8.8.8.8 facebook.com" >> /etc/hosts
fi
