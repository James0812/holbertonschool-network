#!/usr/bin/env bash
# Configures /etc/hosts so localhost resolves to 127.0.0.2 and facebook.com to 8.8.8.8
sed 's/127\.0\.0\.1[ \t]*localhost/127.0.0.2 localhost/' /etc/hosts > /tmp/hosts_new
cp /tmp/hosts_new /etc/hosts
if grep -q "facebook.com" /etc/hosts; then
    sed 's/.*facebook\.com.*/8.8.8.8 facebook.com/' /etc/hosts > /tmp/hosts_new
    cp /tmp/hosts_new /etc/hosts
else
    echo "8.8.8.8 facebook.com" >> /etc/hosts
fi
